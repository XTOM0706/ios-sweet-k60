xnu: K60 触摸 0240：TLMM 引脚与 IOVDD 的 RPMh 投票（默认只到这一步）

把 pong（Nothing Phone 2，同 SM8475）那套 Goodix-over-GENI-SPI 搬到 mondrian。
原实现是 refs/UniXNU-pong/patches/xnu/zzzz...-pong-touch-console.patch 里的
bsd/dev/pong_goodix.c（899 行），一根文件里塞了三块能力（RPMh 投票、GENI SPI、
Goodix 协议）。这里按能力拆成 0240-0243 四个补丁，每个补丁只加一个文件（外加
必要的登记），任何一个中间状态都能单独编译。

这个补丁只有"电"这一半：

  bsd/sys/k60_touch.h      全部硬件常量与模块接口（未定项集中在这里）
  bsd/dev/k60_touch_pins.c AVDD GPIO71 / 复位 GPIO20 / IRQ GPIO21 + 毫秒睡眠
  bsd/dev/k60_touch_rpmh.c pm8350c ldoc2 的 RPMh 投票（command DB + RSC TCS）

为什么先做这一步：0219-0223 的五步 stub 在真机上已经证明三根引脚配得对，但
读到 IRQ 电平是 0 —— 触摸芯片的 IOVDD（pm8350c 的 ldoc2，1.8 V）要应用处理器
往 RPMh 投一票才上电，stub 没有这个能力。所以先补上这一票，判据就是"投票完成
之后 IRQ 电平"。0219-0223 保留但默认退休（见下）。

地址来源（不是照抄 pong 的一律注明）：

  TLMM      0x0f100000 + 0x1000*n   实测。DT 写的 0x0f000000 是错的：按它访问
                                    不 abort，是把互连卡死、等看门狗复位。
  RSC       0x17a20000              live FDT rsc@17a00000，reg 四段 drv-0..3，
                                    qcom,drv-id = 2 -> drv-2。pong 的 rsc-base
                                    数值相同（0x17a20000），出处一致。实测
                                    DRV_ID = 0x20700（主版本 2）；drv-0 一读
                                    就 abort，drv-3 读了会挂，只映射这一页。
  command DB 0x80860000             live FDT aop_cmd_db_region@80860000，与 pong
                                    的 cmd_db_phys 相同。
  IOVDD     "ldoc2"                 live FDT rpmh-regulator-ldoc2 /
                                    regulator-pm8350c-l2（xiaomi_touch 的
                                    vdd-supply 就是 phandle 0x301），init
                                    0x1b7740 uV = 1.8 V。
  AVDD      GPIO71 高有效            live FDT goodix,avdd-gpio <&tlmm 0x47 0>。
                                    K60 上没有第二路 PMIC 轨（pong 有 ldoc3）。

照抄 pong 的部分：msgid（0x10008|0x100 响应位）、VRM_VOLTAGE/ENABLE/MODE =
+0/+4/+8、LDO HPM 模式 = 7、cmdb 条目 8 字节 id 的 memcmp 与 slave 表遍历、
magic db 30 03 0c。这些是 RPMh 硬件的编码，不是板级参数。

2026-10-31 补：TCS 布局与电压这两处原来照抄错了，改用 UniXNU-sheng 的
QcomRpmh 组件（纯算法、不碰硬件）里的做法：

  - TCS 的寄存器偏移按 DRV_ID 的主版本选。本机实测 DRV_ID = 0x20700，
    主版本 2，走 pong 那套老布局；主版本 >= 3 的 RSC 是另一套
    （wait/control/status/cmd_enable 后移到 0x20/0x24/0x28/0x2c，命令步长
    从 20 变 24）。DRV_ID 在 drv-2 块偏移 0，主版本在 bit 23:16。
  - 写 VRM_VOLTAGE 的是 command DB 里该资源的 ARC 等级索引，不是 1800。
    cmd-db 条目的 aux data 是一串 uint16 的等级（毫伏），取第一个不小于
    请求值的索引（1800 mV 落在哪一档由固件决定）。

另外把"读 RSC 之前先映射"写死：上一版在 ml_io_map 之前就读 TCS 的
IRQ_ENABLE（k60_rsc 还是 0，等于读 0xd00 这个野地址），真机上就死在那
一行。现在先映射、打印地址并刷盘，再读 DRV_ID。

顺带让 0219-0223 退休：bsd/dev/k60_touch_spi.c 的 k60_touch_spi_init() 默认
不再起线程（"K60 TOUCH: legacy five-stage probe retired"），只有显式
k60tlegacy=1 才跑；它自己的两个参数改名成 k60tlegacystage / k60tlegacydelay，
免得和新的 k60touchstage 撞名。文件不删、别人的补丁不动。

上机判据（都以 "K60 TOUCH:" 开头，可 grep）：

  init: stage 2 (1 pins, 2 +iovdd, ...)      参数解码，默认 2
  powered: avdd=1 reset=1 irq level 0        引脚配好、复位放过；0 是正常的
  cmd_db magic db 30 03 0c version N         command DB 认出来了
  rpmh resource "ldoc2" -> 0x..., N aux levels (mV)  查到的地址与等级表
  rsc drv id 0x20700 (major 2) -> ...        主版本选布局，本机走老布局
  iovdd 1800 mV -> arc level index N of M    毫伏换成 ARC 等级索引
  iovdd ldoc2 1800 mV (arc index N) mode 7 voted  RPMh 请求完成（成败行）
  irq after iovdd 1                          投票后 IRQ 被芯片拉高 = 芯片上电了

失败时的行：pins failed / iovdd vote failed / iovdd failed / cmd_db has no
db30030c magic。任何一种都只是打印并结束线程，系统照常启动。
diff --git a/bsd/sys/k60_touch.h b/bsd/sys/k60_touch.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/k60_touch.h
@@ -0,0 +1,201 @@
+/*
+ * K60（mondrian，SM8475 / cape）触摸的硬件常量与模块接口。
+ *
+ * 屏上的数字化仪是一颗走 SPI 的 Goodix，挂在 QUPv3 SE4（0x00990000）上，
+ * 与 Nothing Phone 2（pong）的接法一致。这里的每一个地址都能在
+ * refs/UniXNU-pong 的 pong_goodix.c 或 mondrian 的 live FDT 里找到出处，
+ * 出处不同的地方在下面逐行注明；没有出处、只在真机上才可能确认的数值
+ * （RCG 的源、SPI 的波特率、LDO 的模式）集中在本文件末尾的"未定项"。
+ *
+ * 模块划分（每个补丁一件事）：
+ *   0240 bsd/dev/k60_touch_pins.c   TLMM 引脚 + AVDD 使能
+ *        bsd/dev/k60_touch_rpmh.c   RPMh 投票（pm8350c ldoc2 = IOVDD 1.8 V）
+ *   0241 bsd/dev/k60_touch_geni.c   GCC 时钟 + GENI SPI 收发
+ *   0242 bsd/dev/k60_touch_goodix.c Goodix 协议（Berlin 与 GT9xx 两套 ABI）
+ *   0243 bsd/dev/k60_touch.c        线程、boot-arg 分级、上报 SweetHIDTouch
+ */
+#ifndef _SYS_K60_TOUCH_H_
+#define _SYS_K60_TOUCH_H_
+
+#include <stdint.h>
+
+/* ------------------------------------------------------------------ *
+ * 物理地址
+ * ------------------------------------------------------------------ */
+
+/*
+ * TLMM 引脚寄存器：一个引脚一页，页内 0x0 = CFG、0x4 = IN_OUT、
+ * 0x8 = INTR_CFG。基址 0x0f100000 是实测值（DT 的 gpio 节点写
+ * 0x0f000000，按那个地址访问不 abort，会把互连卡死再看门狗复位）。
+ */
+#define K60_TOUCH_TLMM_BASE		0x0f100000UL
+#define K60_TOUCH_TLMM_STRIDE		0x00001000UL
+
+/* live FDT clock-controller@100000。CBCR 在 0x62008、SE4 的 RCG 在 0x274e4，
+ * 两头都在 0x70000 之内，所以整段映射。 */
+#define K60_TOUCH_GCC_BASE		0x00100000UL
+#define K60_TOUCH_GCC_WINDOW		0x00070000UL
+
+/* live FDT spi@990000（compatible qcom,spi-geni，reg <0x990000 0x4000>，
+ * interrupts <0 0x25d 4> = GIC SPI 605，我们不接这根中断，全程轮询）。 */
+#define K60_TOUCH_SE_BASE		0x00990000UL
+#define K60_TOUCH_SE_WINDOW		0x00004000UL
+
+/* live FDT rsc@17a00000：reg 是 drv-0..drv-3 四段、qcom,drv-id = 2，
+ * 所以应用处理器的 TCS 在 0x17a20000。pong 的 rsc-base 是 0x17a20000，
+ * 数值相同，但那边是照抄 DT 的第二个 reg，我们这里是 base + drv * 0x10000。 */
+#define K60_TOUCH_RSC_BASE		0x17a00000UL
+#define K60_TOUCH_RSC_DRV		2
+#define K60_TOUCH_RSC_STRIDE		0x00010000UL
+#define K60_TOUCH_RSC_WINDOW		0x00010000UL
+
+/* live FDT /reserved-memory/aop_cmd_db_region@80860000，compatible qcom,cmd-db。
+ * 与 pong 的 cmd_db_phys = 0x80860000 相同。 */
+#define K60_TOUCH_CMD_DB_BASE		0x80860000UL
+#define K60_TOUCH_CMD_DB_WINDOW		0x00020000UL
+
+/* ------------------------------------------------------------------ *
+ * 引脚（live FDT xiaomi_touch@0 与 pinctrl）
+ * ------------------------------------------------------------------ */
+
+#define K60_TOUCH_GPIO_CLK		16	/* spi4_clk  */
+#define K60_TOUCH_GPIO_MOSI		17	/* spi4_mosi */
+#define K60_TOUCH_GPIO_MISO		18	/* spi4_miso */
+#define K60_TOUCH_GPIO_CS		19	/* spi4_cs   */
+#define K60_TOUCH_GPIO_RESET		20	/* goodix,reset-gpio <&tlmm 0x14 0>，低有效 */
+#define K60_TOUCH_GPIO_IRQ		21	/* goodix,irq-gpio <&tlmm 0x15 0x2008>，输入下拉 */
+#define K60_TOUCH_GPIO_AVDD		71	/* goodix,avdd-gpio <&tlmm 0x47 0>，高有效 */
+
+/* TLMM CFG 的位域：bit0-1 上下拉、bit2-5 功能号、bit6-8 驱动强度、bit9 输出使能。 */
+#define K60_TOUCH_PIN_FUNC_GPIO		0
+#define K60_TOUCH_PIN_FUNC_QUP		1
+#define K60_TOUCH_PIN_PULL_NONE		0
+#define K60_TOUCH_PIN_PULL_DOWN		1
+#define K60_TOUCH_PIN_PULL_UP		3
+#define K60_TOUCH_PIN_DRIVE_2MA		0
+#define K60_TOUCH_PIN_DRIVE_8MA		3
+
+/* 上电时序（毫秒）。全部落在引脚上，与 SE 无关，失败只会多几行日志。 */
+#define K60_TOUCH_RESET_LOW_MS		10
+#define K60_TOUCH_SETTLE_MS		50
+#define K60_TOUCH_FIRST_POLL_MS		1
+
+/* ------------------------------------------------------------------ *
+ * 面板与触点
+ * ------------------------------------------------------------------ */
+
+#define K60_TOUCH_PANEL_W		1440	/* 面板与逻辑分辨率都是 1440x3200 */
+#define K60_TOUCH_PANEL_H		3200
+#define K60_TOUCH_REPORT_MAX		10	/* Berlin 报告里最多十个触点 */
+
+/* live FDT：goodix,panel-max-x = 0x3840 (14400)、panel-max-y = 0x7d00 (32000)，
+ * 单位 0.1 mm。IC 自报的值优先，这两个只是缺省。 */
+#define K60_TOUCH_ABS_MAX_X		14400
+#define K60_TOUCH_ABS_MAX_Y		32000
+
+/* ------------------------------------------------------------------ *
+ * IOVDD（RPMh）：pm8350c 的 ldoc2，1.8 V
+ * ------------------------------------------------------------------ */
+
+/* live FDT rpmh-regulator-ldoc2：qcom,resource-name = "ldoc2"，
+ * regulator-pm8350c-l2，init 0x1b7740 µV = 1.8 V，init-mode 4 (LPM)。
+ * 触摸要 HPM（7），模式数值照 pong。 */
+#define K60_TOUCH_IOVDD_RESOURCE	"ldoc2"
+#define K60_TOUCH_IOVDD_MV		1800
+#define K60_TOUCH_IOVDD_MODE		7
+
+/* VRM 寄存器在 RPMh 地址空间里的偏移（pong 的 VRM_* 定义，硬件编码）。 */
+#define K60_TOUCH_VRM_VOLTAGE		0
+#define K60_TOUCH_VRM_ENABLE		4
+#define K60_TOUCH_VRM_MODE		8
+
+/* ------------------------------------------------------------------ *
+ * GENI SPI
+ * ------------------------------------------------------------------ */
+
+#define K60_TOUCH_SPI_HZ		4000000	/* 先慢后快：DT 的 spi-max-frequency 是 15 MHz */
+#define K60_TOUCH_SPI_MIN_HZ		1000000	/* SER 分频器的下限保护 */
+
+/* ------------------------------------------------------------------ *
+ * 启动分级（boot-arg k60touchstage）
+ *
+ * 默认 2：只上 AVDD、投 IOVDD、读一次 IRQ 电平。这两步全是寄存器读写加
+ * 回读，不碰 SE，也不碰 GCC，最坏情况是多几行日志。第 3 步起要动 GCC 和
+ * SE，时钟配错时一次 SE 访问就能把互连挂住（关中断自旋、看门狗复位），
+ * 所以必须显式打开。
+ * ------------------------------------------------------------------ */
+
+#define K60_TOUCH_STAGE_OFF		0
+#define K60_TOUCH_STAGE_PINS		1	/* AVDD/复位/IRQ */
+#define K60_TOUCH_STAGE_IOVDD		2	/* RPMh ldoc2 投票 + IRQ 电平 */
+#define K60_TOUCH_STAGE_CLOCKS		3	/* GCC 投票与 RCG */
+#define K60_TOUCH_STAGE_GENI		4	/* SE4 配成 SPI + 读 Goodix ID */
+#define K60_TOUCH_STAGE_REPORT		5	/* 轮询触点并上报 SweetHIDTouch */
+#define K60_TOUCH_STAGE_DEFAULT		K60_TOUCH_STAGE_IOVDD
+
+#define K60_TOUCH_BOOT_DELAY_S		20	/* 等 GUI 起来；真挂了日志也已经落盘 */
+#define K60_TOUCH_POLL_MS		8	/* 轮询周期 */
+#define K60_TOUCH_IDLE_POLLS		10	/* 没有中断时也至少这么久读一次 */
+
+/* ------------------------------------------------------------------ *
+ * MMIO 访问
+ *
+ * 换出这两个宏只为宿主冒烟台（tools/k60-touch-harness）能拦读写、模拟
+ * GENI 引擎；内核里就是一次 volatile 读写 + 屏障。
+ * ------------------------------------------------------------------ */
+
+#ifdef K60_TOUCH_HOST_TEST
+extern uint32_t k60_touch_test_read(uintptr_t address);
+extern void k60_touch_test_write(uintptr_t address, uint32_t value);
+#define K60_TOUCH_RD(a)		k60_touch_test_read((uintptr_t)(a))
+#define K60_TOUCH_WR(a, v)	k60_touch_test_write((uintptr_t)(a), (uint32_t)(v))
+#else
+#define K60_TOUCH_RD(a)		(*(volatile uint32_t *)(uintptr_t)(a))
+#define K60_TOUCH_WR(a, v)	do { \
+	*(volatile uint32_t *)(uintptr_t)(a) = (uint32_t)(v); \
+	__asm__ volatile("dsb sy" ::: "memory"); \
+} while (0)
+#endif
+
+/* ------------------------------------------------------------------ *
+ * 模块接口
+ * ------------------------------------------------------------------ */
+
+#ifdef KERNEL
+
+struct k60_touch_state {
+	int stage;			/* 本次允许跑到第几步 */
+	int flush;			/* 每步之前把日志刷盘 */
+	int abi;			/* 探到的 Goodix ABI，见 goodix.c 的 K60_ABI_* */
+	uint32_t abs_max_x, abs_max_y;	/* IC 自报的坐标上限 */
+	uint32_t pins_read;		/* 上电后 IRQ 电平（判据） */
+};
+
+/* 日志落盘开关（0243 按 k60touchflush 设置；0240 的引脚模块默认开）。 */
+extern int k60_touch_flush_on;
+
+/* 0240 */
+void k60_touch_sleep_ms(uint32_t ms);
+void k60_touch_flush(void);
+int k60_touch_pin_config(uint32_t pin, uint32_t function, uint32_t pull, uint32_t drive, int output);
+int k60_touch_pin_level(uint32_t pin, uint32_t *level);
+int k60_touch_pin_output(uint32_t pin, int level, uint32_t pull, uint32_t drive);
+int k60_touch_pins_power(uint32_t *irq_level);
+int k60_touch_iovdd_on(void);
+
+/* 0241 */
+int k60_touch_clocks_on(void);
+int k60_touch_geni_bringup(uint32_t hz, const char **problem);
+int k60_touch_geni_xfer(const uint8_t *tx, uint8_t *rx, uint32_t length);
+
+/* 0242 */
+int k60_touch_goodix_probe(int verbose);
+int k60_touch_goodix_poll(void);
+int k60_touch_goodix_abi(void);
+
+/* 0243 */
+void k60_touch_init(void);
+
+#endif /* KERNEL */
+
+#endif /* _SYS_K60_TOUCH_H_ */
diff --git a/bsd/dev/k60_touch_pins.c b/bsd/dev/k60_touch_pins.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/k60_touch_pins.c
@@ -0,0 +1,214 @@
+/*
+ * K60（mondrian，SM8475）触摸：TLMM 引脚与毫秒睡眠。
+ *
+ * 三根线：AVDD 使能 GPIO71（高有效）、复位 GPIO20（低有效）、IRQ GPIO21
+ * （输入下拉）。SPI 四根线由 0241 在配置 SE 之前交给 QUP。
+ *
+ * 这一层不碰 SE、不碰 GCC：引脚寄存器写错只会让电平不对，不会把互连挂住。
+ * 判据行（全部以 "K60 TOUCH:" 开头，方便 grep）：
+ *   "K60 TOUCH: stage 1: ..."            进入第 1 步
+ *   "K60 TOUCH: pin gpio%u cfg %#x io %#x"每个引脚的原始回读
+ *   "K60 TOUCH: powered: ... irq level %u"上电结束与 IRQ 电平
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/k60_touch.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_log_flush_now(void);
+
+/* 页内偏移：mainline pinctrl-msm 一个引脚一页。 */
+#define K60_PIN_CFG	0x0u
+#define K60_PIN_IN_OUT	0x4u
+
+/*
+ * 引脚页的映射缓存。ml_io_map 每次都会占一段内核虚拟地址，轮询里绝不能
+ * 反复调；这里最多八根线，够这个驱动用。
+ */
+#define K60_PIN_SLOTS	8
+static struct {
+	uint32_t pin;
+	vm_offset_t page;
+} k60_pin_pages[K60_PIN_SLOTS];
+static unsigned k60_pin_used;
+
+int k60_touch_flush_on = 1;
+static int k60_touch_wake_chan;
+
+void
+k60_touch_flush(void)
+{
+	if (k60_touch_flush_on) {
+		sweet_log_flush_now();
+	}
+}
+
+/*
+ * 十几秒的等待用 sleep 而不是 delay()：delay() 会把一个核烧满。毫秒级的
+ * 器件时序仍用 delay()，它更准，也不会在这里被抢占。
+ */
+void
+k60_touch_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&k60_touch_wake_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static vm_offset_t
+k60_pin_page(uint32_t pin)
+{
+	vm_offset_t page;
+	unsigned i;
+
+	for (i = 0; i < k60_pin_used; i++) {
+		if (k60_pin_pages[i].pin == pin) {
+			return k60_pin_pages[i].page;
+		}
+	}
+	if (k60_pin_used == K60_PIN_SLOTS) {
+		printf("K60 TOUCH: pin table full, gpio%u not mapped\n", pin);
+		return 0;
+	}
+	/* 映射之前先落一行：地址写错时互连会卡死，盘上最后一行就是凶手。 */
+	printf("K60 TOUCH: map gpio%u at 0x%lx\n", pin,
+	    (unsigned long)(K60_TOUCH_TLMM_BASE + K60_TOUCH_TLMM_STRIDE * pin));
+	k60_touch_flush();
+	page = ml_io_map(K60_TOUCH_TLMM_BASE + K60_TOUCH_TLMM_STRIDE * pin,
+	    K60_TOUCH_TLMM_STRIDE);
+	if (page == 0) {
+		printf("K60 TOUCH: map gpio%u failed\n", pin);
+		return 0;
+	}
+	k60_pin_pages[k60_pin_used].pin = pin;
+	k60_pin_pages[k60_pin_used].page = page;
+	k60_pin_used++;
+	return page;
+}
+
+static uint32_t
+k60_pin_bits(uint32_t function, uint32_t pull, uint32_t drive, int output)
+{
+	return ((function & 0xfu) << 2) | (pull & 0x3u) | ((drive & 0x7u) << 6) |
+	    (output ? (1u << 9) : 0u);
+}
+
+int
+k60_touch_pin_config(uint32_t pin, uint32_t function, uint32_t pull,
+    uint32_t drive, int output)
+{
+	vm_offset_t page = k60_pin_page(pin);
+	uint32_t want, before, after;
+
+	if (page == 0) {
+		return -1;
+	}
+	want = k60_pin_bits(function, pull, drive, output);
+	before = K60_TOUCH_RD(page + K60_PIN_CFG);
+	K60_TOUCH_WR(page + K60_PIN_CFG, (before & ~0x3ffu) | want);
+	after = K60_TOUCH_RD(page + K60_PIN_CFG);
+	printf("K60 TOUCH: pin gpio%u cfg %#x io %#x\n", pin, after,
+	    K60_TOUCH_RD(page + K60_PIN_IN_OUT));
+	if ((after & 0x3ffu) != want) {
+		printf("K60 TOUCH: pin gpio%u cfg did not take: want %#x got %#x\n",
+		    pin, want, after & 0x3ffu);
+		return -1;
+	}
+	return 0;
+}
+
+int
+k60_touch_pin_level(uint32_t pin, uint32_t *level)
+{
+	vm_offset_t page = k60_pin_page(pin);
+
+	if (page == 0) {
+		return -1;
+	}
+	*level = K60_TOUCH_RD(page + K60_PIN_IN_OUT) & 1u;
+	return 0;
+}
+
+/* 先把输出值写进去、再打开输出使能，否则会有一瞬间把旧值驱动到线上。 */
+int
+k60_touch_pin_output(uint32_t pin, int level, uint32_t pull, uint32_t drive)
+{
+	vm_offset_t page = k60_pin_page(pin);
+
+	if (page == 0) {
+		return -1;
+	}
+	K60_TOUCH_WR(page + K60_PIN_IN_OUT, level ? 2u : 0u);
+	return k60_touch_pin_config(pin, K60_TOUCH_PIN_FUNC_GPIO, pull, drive, 1);
+}
+
+int
+k60_touch_pins_power(uint32_t *irq_level)
+{
+	uint32_t level = 0;
+
+	printf("K60 TOUCH: stage 1: avdd gpio%u, reset gpio%u, irq gpio%u\n",
+	    K60_TOUCH_GPIO_AVDD, K60_TOUCH_GPIO_RESET, K60_TOUCH_GPIO_IRQ);
+	k60_touch_flush();
+
+	/* 先看引导装载程序留下的样子：功能 0、输入，不驱动任何一根线。 */
+	if (k60_touch_pin_config(K60_TOUCH_GPIO_AVDD, K60_TOUCH_PIN_FUNC_GPIO,
+	    K60_TOUCH_PIN_PULL_NONE, K60_TOUCH_PIN_DRIVE_2MA, 0) != 0 ||
+	    k60_touch_pin_config(K60_TOUCH_GPIO_RESET, K60_TOUCH_PIN_FUNC_GPIO,
+	    K60_TOUCH_PIN_PULL_NONE, K60_TOUCH_PIN_DRIVE_8MA, 0) != 0 ||
+	    k60_touch_pin_config(K60_TOUCH_GPIO_IRQ, K60_TOUCH_PIN_FUNC_GPIO,
+	    K60_TOUCH_PIN_PULL_DOWN, K60_TOUCH_PIN_DRIVE_2MA, 0) != 0) {
+		printf("K60 TOUCH: pins unavailable, stopping\n");
+		k60_touch_flush();
+		return -1;
+	}
+
+	/* AVDD 开、复位按住。 */
+	if (k60_touch_pin_output(K60_TOUCH_GPIO_AVDD, 1, K60_TOUCH_PIN_PULL_NONE,
+	    K60_TOUCH_PIN_DRIVE_2MA) != 0 ||
+	    k60_touch_pin_output(K60_TOUCH_GPIO_RESET, 0, K60_TOUCH_PIN_PULL_NONE,
+	    K60_TOUCH_PIN_DRIVE_8MA) != 0) {
+		printf("K60 TOUCH: avdd/reset drive failed, stopping\n");
+		k60_touch_flush();
+		return -1;
+	}
+	printf("K60 TOUCH: avdd on, reset low for %u ms\n",
+	    K60_TOUCH_RESET_LOW_MS);
+	k60_touch_flush();
+	delay(K60_TOUCH_RESET_LOW_MS * 1000);
+
+	/* 放开复位，等芯片起振。 */
+	(void)k60_touch_pin_output(K60_TOUCH_GPIO_RESET, 1,
+	    K60_TOUCH_PIN_PULL_NONE,
+	    K60_TOUCH_PIN_DRIVE_8MA);
+	printf("K60 TOUCH: reset released, settling %u ms\n",
+	    K60_TOUCH_SETTLE_MS);
+	k60_touch_flush();
+	delay(K60_TOUCH_SETTLE_MS * 1000);
+
+	if (k60_touch_pin_level(K60_TOUCH_GPIO_IRQ, &level) != 0) {
+		return -1;
+	}
+	/*
+	 * 判据。level 是原始电平：IRQ 开漏、未触发时是浮的，下拉就把它读成 0；
+	 * 所以 0 不代表"没上电"，真正的答案在第 2 步投票之后的同一个电平、和
+	 * 第 4 步的产品 id 里。这两行只负责记录，不判成败。
+	 */
+	printf("K60 TOUCH: powered: avdd=1 reset=1 irq level %u\n", level);
+	k60_touch_flush();
+	if (irq_level != NULL) {
+		*irq_level = level;
+	}
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/k60_touch_rpmh.c b/bsd/dev/k60_touch_rpmh.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/k60_touch_rpmh.c
@@ -0,0 +1,431 @@
+/*
+ * K60（mondrian，SM8475）触摸：IOVDD 的 RPMh 投票。
+ *
+ * 触摸芯片那一路 IOVDD 是 pm8350c 的 ldoc2（1.8 V），要应用处理器往 RPMh
+ * 投一票才会上电。这里只做一件事：在 command DB 里按名字找到 ldoc2 的
+ * RPMh 地址，把 1.8 V 换算成 command DB 给的 ARC 等级索引，然后用 RSC
+ * 的 TCS 槽位发三条 4 字节写（电压、使能、模式）。
+ *
+ * 地址：
+ *   RSC        0x17a20000 = live FDT rsc@17a00000 + drv-id 2 * 0x10000
+ *   command DB 0x80860000 = live FDT aop_cmd_db_region@80860000（同 pong）
+ *   regulator  "ldoc2"    = live FDT rpmh-regulator-ldoc2 / pm8350c_l2
+ *
+ * 实测（2026-10-31）：drv-2 可读，DRV_ID = 0x20700（主版本 2，老布局），
+ * TCS 0xd00 的 IRQ_ENABLE 已经是 1。drv-0 一读就 abort、drv-3 读了会挂，
+ * 所以只映射这一页 0x10000，一个字节都不越界。
+ *
+ * 与 pong 的 pong_goodix.c 有两处不同，都是照 UniXNU-sheng 的 QcomRpmh
+ * 组件改的：
+ *   1. TCS 的寄存器布局按 DRV_ID 的主版本选。pong 那代（主版本 < 3）的
+ *      wait/control/status/cmd_enable 在 0x10/0x14/0x18/0x1c，命令步长 20；
+ *      主版本 >= 3 改到 0x20/0x24/0x28/0x2c，命令步长 24。DRV_ID 在 DRV
+ *      块偏移 0，主版本在 bit 23:16。
+ *   2. 写进 VRM_VOLTAGE 的不是毫伏，而是 command DB 里该资源的 ARC 等级
+ *      索引。cmd-db 条目的 aux data 是一串 uint16 的等级（毫伏），取第一个
+ *      不小于请求值的索引。
+ *
+ * 判据行：
+ *   "K60 TOUCH: cmd_db magic ..."      command DB 认得出来
+ *   "K60 TOUCH: rsc drv id ..."        RSC 主版本与选中的布局
+ *   "K60 TOUCH: rpmh resource \"ldoc2\" -> ..."  查到的地址与等级表
+ *   "K60 TOUCH: iovdd 1800 mV -> arc level index ..."  电压换算成索引
+ *   "K60 TOUCH: iovdd ldoc2 1800 mV (arc index N) mode 7 voted ..."  投票完成
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/k60_touch.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/* live FDT：rsc@17a00000，qcom,drv-id = 2 -> 应用处理器的 TCS 在 drv-2。 */
+#define K60_RSC_PHYS	(K60_TOUCH_RSC_BASE + K60_TOUCH_RSC_STRIDE * K60_TOUCH_RSC_DRV)
+
+/* DRV_ID 在 DRV 块偏移 0，主版本在 bit 23:16。 */
+#define K60_RSC_DRV_ID		0u
+/* DT 的 tcs-offset：TCS 槽位 0 在这一页的 0xd00。 */
+#define K60_RSC_TCS_OFFSET	0xd00u
+
+#define K60_TCS(reg)		(k60_rsc + K60_RSC_TCS_OFFSET + (reg))
+
+/* 两种布局里位置不变的寄存器。 */
+#define K60_TCS_IRQ_ENABLE	0x00u
+#define K60_TCS_IRQ_CLEAR	0x08u
+#define K60_TCS_CONTROL_ACTIVE_MODE	(1u << 16)
+#define K60_TCS_CONTROL_TRIGGER		(1u << 24)
+
+/* msgid：4 字节载荷、要求响应、写。 */
+#define K60_MSGID_WRITE_4_BYTES	0x10008u
+#define K60_MSGID_RESPONSE	0x100u
+
+#define K60_RPMH_MAX_LEVELS	16u
+
+/* TCS 的寄存器布局，偏移相对 TCS 槽位 0（DRV 基址 + tcs-offset）。 */
+struct k60_rsc_layout {
+	uint32_t tcs_stride, cmd_stride;
+	uint32_t irq_status, irq_clear, wait_for_cmpl, control, status;
+	uint32_t cmd_enable, cmd_msgid, cmd_addr, cmd_data;
+};
+
+/* RSC 主版本 >= 3：wait/control/status/cmd_enable 后移，命令步长 24。 */
+static const struct k60_rsc_layout k60_rsc_layout_v3 = {
+	672, 24, 0x04, 0x08, 0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c
+};
+
+/* pong 那代（主版本 < 3）：命令步长 20。 */
+static const struct k60_rsc_layout k60_rsc_layout_v2 = {
+	672, 20, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38
+};
+
+static vm_offset_t k60_rsc, k60_cmd_db;
+static int k60_iovdd_done;
+
+struct k60_cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+
+struct k60_cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct k60_cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+
+/* 条目 24 字节；length/offset 指向 data 区里的 aux data（等级表）。 */
+struct k60_cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+struct k60_rpmh_resource {
+	uint32_t address;
+	uint16_t levels[K60_RPMH_MAX_LEVELS];
+	unsigned level_count;
+};
+
+static int
+k60_fits(uint32_t offset, uint32_t length, uint32_t size)
+{
+	return offset <= size && length <= size - offset;
+}
+
+static int
+k60_cmd_db_map(void)
+{
+	const struct k60_cmd_db_header *db;
+
+	if (k60_cmd_db != 0) {
+		return 0;
+	}
+	k60_cmd_db = ml_io_map(K60_TOUCH_CMD_DB_BASE, K60_TOUCH_CMD_DB_WINDOW);
+	if (k60_cmd_db == 0) {
+		printf("K60 TOUCH: cmd_db map failed\n");
+		return -1;
+	}
+	db = (const struct k60_cmd_db_header *)k60_cmd_db;
+	printf("K60 TOUCH: cmd_db magic %02x %02x %02x %02x version %u\n",
+	    db->magic[0], db->magic[1], db->magic[2], db->magic[3],
+	    db->version);
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 ||
+	    db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		printf("K60 TOUCH: cmd_db has no db30030c magic, no RPMh vote\n");
+		return -1;
+	}
+	return 0;
+}
+
+/*
+ * 把条目里的 aux data 读成等级表。aux data 是一串小端 uint16（毫伏），
+ * 表尾用零填充；长度对不上窗口就算坏条目。
+ */
+static int
+k60_rpmh_levels(const struct k60_cmd_db_header *db, uint32_t data_offset,
+    const struct k60_cmd_db_entry *entry, struct k60_rpmh_resource *out)
+{
+	uint32_t at, length, l;
+	uint16_t level;
+
+	memset(out, 0, sizeof(*out));
+	out->address = entry->address;
+	if (out->address == 0) {
+		printf("K60 TOUCH: cmd_db entry \"%.8s\" has no address\n",
+		    entry->id);
+		return -1;
+	}
+	length = entry->length;
+	at = data_offset + entry->offset;
+	if (!k60_fits(at, length, K60_TOUCH_CMD_DB_WINDOW)) {
+		printf("K60 TOUCH: cmd_db aux data %#x+%u is outside the window\n",
+		    at, length);
+		return -1;
+	}
+	for (l = 0; l + 1 < length && out->level_count < K60_RPMH_MAX_LEVELS;
+	    l += 2) {
+		level = (uint16_t)(db->data[at + l] |
+		    ((uint16_t)db->data[at + l + 1] << 8));
+		if (out->level_count != 0 && level == 0) {
+			break;	/* 等级表是零填充的 */
+		}
+		out->levels[out->level_count++] = level;
+	}
+	return 0;
+}
+
+/*
+ * 按名字查 RPMh 地址与等级表（0 = 成功）。pong 只查小写；这里再补一次
+ * 全大写，因为 command DB 的条目大小写在不同固件上不一致，查到哪个都
+ * 打出来。
+ */
+static int
+k60_rpmh_find(const char *name, struct k60_rpmh_resource *out)
+{
+	const struct k60_cmd_db_header *db;
+	const struct k60_cmd_db_entry *entry;
+	char id[8], upper[8];
+	unsigned s, i;
+	uint32_t header_offset, data_offset, count, table_bytes;
+
+	if (k60_cmd_db_map() != 0) {
+		return -1;
+	}
+	memset(id, 0, sizeof(id));
+	memset(upper, 0, sizeof(upper));
+	for (i = 0; i < sizeof(id) - 1 && name[i] != '\0'; i++) {
+		id[i] = name[i];
+		upper[i] = (name[i] >= 'a' && name[i] <= 'z') ?
+		    (char)(name[i] - 'a' + 'A') : name[i];
+	}
+	db = (const struct k60_cmd_db_header *)k60_cmd_db;
+	for (s = 0; s < 8; s++) {
+		const struct k60_cmd_db_slave *slave = &db->slave[s];
+
+		header_offset = slave->header_offset;
+		data_offset = slave->data_offset;
+		count = slave->count;
+		table_bytes = count * (uint32_t)sizeof(*entry);
+		/* 表头本身（144 = 4 + 4 + 8 个 slave + 8）与整张表都必须在窗口内。 */
+		if (slave->id == 0 || count > 512 ||
+		    !k60_fits(header_offset, table_bytes,
+		    K60_TOUCH_CMD_DB_WINDOW) ||
+		    data_offset > K60_TOUCH_CMD_DB_WINDOW) {
+			continue;
+		}
+		entry = (const struct k60_cmd_db_entry *)(db->data +
+		    header_offset);
+		for (i = 0; i < count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0 &&
+			    memcmp(entry[i].id, upper, sizeof(id)) != 0) {
+				continue;
+			}
+			if (k60_rpmh_levels(db, data_offset, &entry[i],
+			    out) != 0) {
+				return -1;
+			}
+			printf("K60 TOUCH: rpmh resource \"%s\" -> %#x, "
+			    "%u aux levels (mV): %u %u %u %u\n", name,
+			    out->address, out->level_count,
+			    out->level_count > 0 ? out->levels[0] : 0,
+			    out->level_count > 1 ? out->levels[1] : 0,
+			    out->level_count > 2 ? out->levels[2] : 0,
+			    out->level_count > 3 ? out->levels[3] : 0);
+			return 0;
+		}
+	}
+	printf("K60 TOUCH: rpmh resource \"%s\" is not in the command db\n",
+	    name);
+	return -1;
+}
+
+/*
+ * 等级 -> ARC 索引：取第一个不小于请求值的等级；请求值高过整张表时取
+ * 最后一个（最高档）；0 表示关掉这一票，索引 0。
+ */
+static int
+k60_rpmh_level_index(const struct k60_rpmh_resource *r, uint32_t mv,
+    uint32_t *index)
+{
+	unsigned i;
+
+	if (r->level_count == 0) {
+		return -1;
+	}
+	if (mv == 0) {
+		*index = 0;
+		return 0;
+	}
+	for (i = 0; i < r->level_count; i++) {
+		if (r->levels[i] >= mv) {
+			*index = i;
+			return 0;
+		}
+	}
+	*index = r->level_count - 1;
+	return 0;
+}
+
+/* 映射 drv-2 并读 DRV_ID；主版本 >= 3 用新布局，读之前先落一行盘。 */
+static const struct k60_rsc_layout *
+k60_rsc_map(void)
+{
+	const struct k60_rsc_layout *layout;
+	uint32_t drv_id;
+	unsigned major;
+
+	if (k60_rsc == 0) {
+		k60_rsc = ml_io_map(K60_RSC_PHYS, K60_TOUCH_RSC_WINDOW);
+		if (k60_rsc == 0) {
+			printf("K60 TOUCH: rpmh: rsc map failed at %#lx\n",
+			    (unsigned long)K60_RSC_PHYS);
+			return 0;
+		}
+	}
+	k60_touch_flush();
+	printf("K60 TOUCH: rsc drv-2 mapped at %#lx, reading drv id at %#lx\n",
+	    (unsigned long)k60_rsc, (unsigned long)(k60_rsc + K60_RSC_DRV_ID));
+	k60_touch_flush();
+	drv_id = K60_TOUCH_RD(k60_rsc + K60_RSC_DRV_ID);
+	major = (drv_id >> 16) & 0xffu;
+	layout = major >= 3 ? &k60_rsc_layout_v3 : &k60_rsc_layout_v2;
+	printf("K60 TOUCH: rsc drv id %#x (major %u) -> tcs %#lx, layout %s: "
+	    "cmd stride %u, wait %#x control %#x status %#x cmd_enable %#x\n",
+	    drv_id, major, (unsigned long)(k60_rsc + K60_RSC_TCS_OFFSET),
+	    major >= 3 ? "v3" : "v2", layout->cmd_stride,
+	    layout->wait_for_cmpl, layout->control, layout->status,
+	    layout->cmd_enable);
+	k60_touch_flush();
+	return layout;
+}
+
+static int
+k60_rpmh_wait(uint32_t offset, uint32_t mask, uint32_t value,
+    const char *what)
+{
+	int i;
+
+	for (i = 0; i < 2000; i++) {
+		if ((K60_TOUCH_RD(K60_TCS(offset)) & mask) == value) {
+			return 0;
+		}
+		delay(100);
+	}
+	printf("K60 TOUCH: rpmh: timeout waiting for %s (tcs+%#x = %#x)\n",
+	    what, offset, K60_TOUCH_RD(K60_TCS(offset)));
+	return -1;
+}
+
+/* 一次发 count (<= 4) 条 4 字节写，等槽位报完成，再把槽位收回空闲。 */
+static int
+k60_rpmh_active_request(const struct k60_rsc_layout *l, unsigned tcs,
+    const uint32_t *address, const uint32_t *value, unsigned count)
+{
+	uint32_t base = l->tcs_stride * tcs;
+	uint32_t mask;
+	uint32_t irq_enable;
+	unsigned i;
+	int error;
+
+	if (k60_rsc == 0 || count == 0 || count > 4) {
+		return -1;
+	}
+	mask = (1u << count) - 1;
+	irq_enable = K60_TOUCH_RD(K60_TCS(K60_TCS_IRQ_ENABLE));
+	/* 关键：写命令之前先把控制位与使能位清掉，让硬件认这个槽是空闲的。 */
+	K60_TOUCH_WR(K60_TCS(base + l->control), 0);
+	K60_TOUCH_WR(K60_TCS(base + l->cmd_enable), 0);
+	delay(100);
+	/* 只记录不拦：pong 那套和 QcomRpmh 都不看 status，清掉控制位就是空闲。 */
+	printf("K60 TOUCH: tcs control %#x status %#x cmd_enable %#x before "
+	    "the request\n",
+	    K60_TOUCH_RD(K60_TCS(base + l->control)),
+	    K60_TOUCH_RD(K60_TCS(l->status)),
+	    K60_TOUCH_RD(K60_TCS(base + l->cmd_enable)));
+	k60_touch_flush();
+	K60_TOUCH_WR(K60_TCS(l->irq_clear), 1u << tcs);
+	for (i = 0; i < count; i++) {
+		uint32_t cmd = base + l->cmd_stride * i;
+
+		K60_TOUCH_WR(K60_TCS(cmd + l->cmd_msgid),
+		    K60_MSGID_WRITE_4_BYTES | K60_MSGID_RESPONSE);
+		K60_TOUCH_WR(K60_TCS(cmd + l->cmd_addr), address[i]);
+		K60_TOUCH_WR(K60_TCS(cmd + l->cmd_data), value[i]);
+	}
+	K60_TOUCH_WR(K60_TCS(base + l->wait_for_cmpl), mask);
+	K60_TOUCH_WR(K60_TCS(base + l->cmd_enable), mask);
+	/* 槽位的中断位要开，完成状态才一定会写；结束再恢复。 */
+	K60_TOUCH_WR(K60_TCS(K60_TCS_IRQ_ENABLE), irq_enable | (1u << tcs));
+	K60_TOUCH_WR(K60_TCS(base + l->control), K60_TCS_CONTROL_ACTIVE_MODE);
+	K60_TOUCH_WR(K60_TCS(base + l->control),
+	    K60_TCS_CONTROL_ACTIVE_MODE | K60_TCS_CONTROL_TRIGGER);
+
+	error = k60_rpmh_wait(l->irq_status, 1u << tcs, 1u << tcs,
+	    "the request");
+	/* finish：清中断、清控制与使能，槽位回到空闲。 */
+	K60_TOUCH_WR(K60_TCS(l->irq_clear), 1u << tcs);
+	K60_TOUCH_WR(K60_TCS(base + l->control), 0);
+	K60_TOUCH_WR(K60_TCS(base + l->cmd_enable), 0);
+	K60_TOUCH_WR(K60_TCS(base + l->wait_for_cmpl), 0);
+	K60_TOUCH_WR(K60_TCS(K60_TCS_IRQ_ENABLE), irq_enable);
+	return error;
+}
+
+int
+k60_touch_iovdd_on(void)
+{
+	const struct k60_rsc_layout *layout;
+	struct k60_rpmh_resource res;
+	uint32_t address[3], value[3], index = 0;
+	uint32_t mv = K60_TOUCH_IOVDD_MV;
+	uint32_t mode = K60_TOUCH_IOVDD_MODE;
+	int error;
+
+	if (k60_iovdd_done) {
+		return 0;
+	}
+	printf("K60 TOUCH: stage 2: iovdd pm8350c \"%s\" -> %u mV mode %u\n",
+	    K60_TOUCH_IOVDD_RESOURCE, mv, mode);
+	k60_touch_flush();
+	layout = k60_rsc_map();
+	if (layout == 0) {
+		return -1;
+	}
+	if (k60_rpmh_find(K60_TOUCH_IOVDD_RESOURCE, &res) != 0) {
+		return -1;
+	}
+	if (k60_rpmh_level_index(&res, mv, &index) != 0) {
+		printf("K60 TOUCH: rpmh resource \"%s\" has no aux levels, "
+		    "cannot map %u mV\n", K60_TOUCH_IOVDD_RESOURCE, mv);
+		k60_touch_flush();
+		return -1;
+	}
+	printf("K60 TOUCH: iovdd %u mV -> arc level index %u of %u "
+	    "(levels %u %u %u %u mV)\n", mv, index, res.level_count,
+	    res.levels[0], res.levels[1], res.levels[2], res.levels[3]);
+	k60_touch_flush();
+	address[0] = res.address + K60_TOUCH_VRM_VOLTAGE;
+	address[1] = res.address + K60_TOUCH_VRM_ENABLE;
+	address[2] = res.address + K60_TOUCH_VRM_MODE;
+	value[0] = index;
+	value[1] = 1;		/* 打开 */
+	value[2] = mode;
+	error = k60_rpmh_active_request(layout, 0, address, value, 3);
+	if (error != 0) {
+		printf("K60 TOUCH: iovdd vote failed, touch will not answer\n");
+		k60_touch_flush();
+		return -1;
+	}
+	k60_iovdd_done = 1;
+	printf("K60 TOUCH: iovdd ldoc2 %u mV (arc index %u) mode %u voted "
+	    "(rpmh done)\n", mv, index, mode);
+	k60_touch_flush();
+	return 0;
+}
