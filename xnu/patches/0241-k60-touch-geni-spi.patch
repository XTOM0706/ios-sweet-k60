xnu: K60 触摸 0241：GCC 时钟与 QUPv3 SE4 上的 GENI SPI

0240 把电送上了；这个补丁把 SE4（0x00990000）配成 SPI，能发一笔全双工传输。

  bsd/dev/k60_touch_geni.c   GCC 投票 + RCG + GENI SPI 初始化 + 收发 + 恢复

K60 与 pong 的 SPI 控制器完全一致（都是 QUPv3 SE4 @ 0x990000，reg 0x4000，
GIC SPI 605），所以寄存器表与 pong 的 pong_goodix.c 一样；但时钟这一半改成
从本机源码对齐过的值（clkref/gcc-sm8450.c，SM8450 与 cape 是同一套 GCC）：

  gcc_qupv3_wrap_0_m_ahb_clk    halt 0x27004, 0x62008 的 bit 6
  gcc_qupv3_wrap_0_s_ahb_clk    halt 0x27008, 0x62008 的 bit 7
  gcc_qupv3_wrap0_core_clk      halt 0x33000, 0x62008 的 bit 8
  gcc_qupv3_wrap0_core_2x_clk   halt 0x3300c, 0x62008 的 bit 9
  gcc_qupv3_wrap0_s4_clk        halt 0x274dc, 0x62008 的 bit 14
  gcc_qupv3_wrap0_s4_clk_src    RCG cmd 0x274e4 / cfg 0x274e8

live FDT 的 clocks = <&gcc 94 134 135>（se-clk / m-ahb / s-ahb）与这张表一致。
RCG 的 CMD 位（bit0 UPDATE、bit1 ROOT_EN、bit31 ROOT_OFF）与 CFG 的父源编号
（0 = XO 19.2 MHz、1 = GPLL0 600 MHz、6 = GPLL0/2 300 MHz）来自 clk-rcg2 的
通用布局；根已经开着就只解码、不重配（引导装载程序可能给了 100 MHz）。

三道闸门，任何一道不过就停在 SE 之前 —— 时钟没真的开起来时一次 SE 访问就能
把互连挂住（关中断自旋、看门狗复位），这是整条链路唯一会"一开机就挂"的操作：

  1. 0x62008 的五个投票位回读全立住
  2. 0x27004 / 0x27008 / 0x274dc 的 bit31（halt）全清
  3. SE 的根时钟不是 ROOT_OFF

SPI 参数：模式 0、8 位、四字节打包（0x0007f8fe / 0x000ffefe，mainline
geni_se_config_packing(8, 4, ...)）、FIFO 模式（不用 DMA、不用 GSI）、M 通道
中断全程屏蔽（GIC SPI 605 没人认领，使能了就是一条悬空中断）。波特率按
k60touchhz（默认 4 MHz）与 CFR 解出来的父源算分频；父源未知时按 600 MHz 估，
只会把时钟算慢，不会算快。

传输的语义（TRANS_LEN 写字节数，而不是字数）与 pong 相同，因为 pong 那套在
真机上跑通过，而 0219-0223 的 stub（写字数）从来没上过机。留了 k60touchlenw=1
可以切回字数，方便上机对比。

上机判据：

  stage 3: gcc 0x100000 window 0x70000, no SE access yet
  gcc vote 0x... -> 0x... , bits 0x7fc0      五个位（6/7/8/9/14）都写进去了
  gcc halt m/s/se 0x.../0x.../0x...          bit31 全清 = 时钟真的在跑
  clocks ready: vote 0x... halt ... source 19200000 Hz   ← 第 3 步的通过行
  se4 fw 0x102 version 2 protocol 1 (SPI=1)  引导装载程序装的是 SPI 固件
  se4 spi cfg word 0x4 mclk 0x51 (source 19200000 Hz / 5)
  se4 pins gpio16-19 -> qup                  四根线交给 QUP
  se4 status 0x0 fifo 64 words               引擎空闲

失败时：clocks not ready ... stopping before SE / gcc refused N vote bit(s) /
se4 has no SPI firmware / se4 FIFO interface is disabled / spi xfer N bytes
failed: status ...。所有轮询都有上限（2000 圈 100 us 或 200 ms 截止），不会
无界自旋。
diff --git a/bsd/dev/k60_touch_geni.c b/bsd/dev/k60_touch_geni.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/k60_touch_geni.c
@@ -0,0 +1,516 @@
+/*
+ * K60（mondrian，SM8475）触摸：GCC 时钟与 QUPv3 SE4 上的 GENI SPI。
+ *
+ * 三个地址与 pong 完全一致，且都能在本机源码里对齐：
+ *   SE4        0x00990000（live FDT spi@990000）
+ *   GCC        0x00100000（live FDT clock-controller@100000）
+ *   分支投票    0x62008，位 6=m-ahb、7=s-ahb、8=wrap0-core、9=wrap0-core-2x、
+ *              14=wrap0 的 s4 分支
+ * 位号与寄存器偏移来自 clkref/gcc-sm8450.c（SM8450 与 cape 同一套 GCC）：
+ *   gcc_qupv3_wrap_0_m_ahb_clk    halt 0x27004, vote 0x62008 bit 6
+ *   gcc_qupv3_wrap_0_s_ahb_clk    halt 0x27008, vote 0x62008 bit 7
+ *   gcc_qupv3_wrap0_core_clk      halt 0x33000, vote 0x62008 bit 8
+ *   gcc_qupv3_wrap0_core_2x_clk   halt 0x3300c, vote 0x62008 bit 9
+ *   gcc_qupv3_wrap0_s4_clk        halt 0x274dc, vote 0x62008 bit 14
+ *   gcc_qupv3_wrap0_s4_clk_src    RCG cmd 0x274e4（cfg +4）
+ * RCG 的 CMD 位：bit0 UPDATE、bit1 ROOT_EN、bit31 ROOT_OFF；CFG 的
+ * [10:8] 父源（0 = XO 19.2 MHz、1 = GPLL0 600 MHz、6 = GPLL0/2 300 MHz）。
+ *
+ * 一次 SE 访问就可能在时钟没真的开起来时把互连挂住（关中断自旋、看门狗
+ * 复位），所以这里把"时钟好了"当成进入 GENI 配置的硬门槛，并且每一步都
+ * 先刷盘。判据行：
+ *   "K60 TOUCH: gcc vote %#x -> %#x, bits %#x"   投票前后与哪些位立住
+ *   "K60 TOUCH: gcc halt m/s/se %#x/%#x/%#x"     三条分支的 halt 状态
+ *   "K60 TOUCH: clocks ready: ..."               第 3 步的通过行
+ *   "K60 TOUCH: se4 fw %#x version %u protocol %u (SPI=1) fifo %u"
+ *   "K60 TOUCH: se4 spi cfg word %#x mclk %#x (source %u Hz / %u)"
+ *   "K60 TOUCH: se4 pins gpio16-19 -> qup"
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/k60_touch.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/* ---- GCC ------------------------------------------------------------------ */
+
+#define K60_GCC_VOTE		0x62008u
+#define K60_GCC_VOTE_M_AHB	(1u << 6)
+#define K60_GCC_VOTE_S_AHB	(1u << 7)
+#define K60_GCC_VOTE_CORE	(1u << 8)
+#define K60_GCC_VOTE_CORE_2X	(1u << 9)
+#define K60_GCC_VOTE_SE4	(1u << 14)
+/* The five branches gcc-sm8450.c enables for QUPV3 wrap 0 (SE4 @ 0x990000). */
+#define K60_GCC_VOTE_MASK	(K60_GCC_VOTE_M_AHB | K60_GCC_VOTE_S_AHB | \
+				 K60_GCC_VOTE_CORE | K60_GCC_VOTE_CORE_2X | \
+				 K60_GCC_VOTE_SE4)
+
+#define K60_GCC_CORE_2X_HALT	0x3300cu
+#define K60_GCC_CORE_HALT	0x33000u
+#define K60_GCC_M_AHB_HALT	0x27004u
+#define K60_GCC_S_AHB_HALT	0x27008u
+#define K60_GCC_SE4_HALT	0x274dcu
+#define K60_GCC_SE4_CMD		0x274e4u
+#define K60_GCC_SE4_CFG		0x274e8u
+
+#define K60_RCG_UPDATE		(1u << 0)
+#define K60_RCG_ROOT_EN		(1u << 1)
+#define K60_RCG_ROOT_OFF	(1u << 31)
+#define K60_RCG_SRC_SHIFT	8
+#define K60_RCG_SRC_MASK	(7u << K60_RCG_SRC_SHIFT)
+#define K60_RCG_DIV_MASK	0x1fu
+#define K60_RCG_MODE_MASK	(3u << 12)
+#define K60_CLOCK_OFF		(1u << 31)
+
+#define K60_XO_HZ		19200000u
+#define K60_GPLL0_MAIN_HZ	600000000u
+#define K60_GPLL0_EVEN_HZ	300000000u
+
+/* ---- GENI SE4 ------------------------------------------------------------- */
+
+#define K60_SE_FORCE_DEFAULT	0x020u
+#define K60_SE_OUTPUT_CTRL	0x024u
+#define K60_SE_CGC_CTRL		0x028u
+#define K60_SE_STATUS		0x040u	/* bit0：有命令在跑 */
+#define K60_SE_SER_M_CLK_CFG	0x048u	/* bit0 使能、[15:4] 分频 */
+#define K60_SE_IF_DISABLE_RO	0x064u
+#define K60_SE_FW_REVISION_RO	0x068u	/* [15:8] 协议：1 = SPI */
+#define K60_SE_CLK_SEL		0x07cu
+#define K60_SE_SPI_CPHA		0x224u
+#define K60_SE_SPI_LOOPBACK	0x22cu
+#define K60_SE_SPI_CPOL		0x230u
+#define K60_SE_SPI_DEMUX_OUTPUT_INV 0x24cu
+#define K60_SE_SPI_DEMUX_SEL	0x250u
+#define K60_SE_BYTE_GRAN	0x254u
+#define K60_SE_DMA_MODE_EN	0x258u
+#define K60_SE_SPI_TRANS_CFG	0x25cu
+#define K60_SE_TX_PACKING_0	0x260u
+#define K60_SE_TX_PACKING_1	0x264u
+#define K60_SE_SPI_WORD_LEN	0x268u
+#define K60_SE_SPI_TX_TRANS_LEN	0x26cu
+#define K60_SE_SPI_RX_TRANS_LEN	0x270u
+#define K60_SE_SPI_DELAY	0x278u
+#define K60_SE_RX_PACKING_0	0x284u
+#define K60_SE_RX_PACKING_1	0x288u
+#define K60_SE_M_CMD0		0x600u
+#define K60_SE_M_CMD_CTRL	0x604u	/* bit2 取消、bit1 中止 */
+#define K60_SE_M_IRQ_STATUS	0x610u
+#define K60_SE_M_IRQ_EN		0x614u
+#define K60_SE_M_IRQ_CLEAR	0x618u
+#define K60_SE_S_IRQ_CLEAR	0x648u
+#define K60_SE_TX_FIFO		0x700u
+#define K60_SE_RX_FIFO		0x780u
+#define K60_SE_TX_FIFO_STATUS	0x800u
+#define K60_SE_RX_FIFO_STATUS	0x804u
+#define K60_SE_TX_WATERMARK	0x80cu
+#define K60_SE_RX_WATERMARK	0x810u
+#define K60_SE_RX_RFR_WATERMARK	0x814u
+#define K60_SE_DMA_TX_IRQ_CLR	0xc44u
+#define K60_SE_DMA_RX_IRQ_CLR	0xd44u
+#define K60_SE_GSI_EVENT_EN	0xe18u
+#define K60_SE_IRQ_EN		0xe1cu
+#define K60_SE_HW_PARAM_0	0xe24u	/* [21:16] FIFO 深度（字数） */
+#define K60_SE_DMA_GENERAL_CFG	0xe30u
+
+#define K60_M_DONE		(1u << 0)
+#define K60_M_CANCEL_ACK	(1u << 4)
+#define K60_M_ABORT_ACK		(1u << 5)
+#define K60_M_ERRORS		((1u << 1) | (1u << 2) | (1u << 3) | \
+				 (1u << 24) | (1u << 25) | (1u << 28) | \
+				 (1u << 29))
+#define K60_SPI_FULL_DUPLEX	(3u << 27)
+
+/* mainline geni_se_config_packing(8, 4, true, true, true)，pong 同值。 */
+#define K60_SPI_PACK_0		0x0007f8feu
+#define K60_SPI_PACK_1		0x000ffefeu
+#define K60_SPI_WORD_LEN_VAL	(8 - 4)
+
+static vm_offset_t k60_gcc, k60_se;
+static uint32_t k60_fifo_depth;
+static uint32_t k60_se_source_hz;
+static int k60_len_words;	/* k60touchlenw=1：TRANS_LEN 写字数而不是字节 */
+static unsigned k60_xfer_complaints;
+
+/* 父源的标称频率：只用来给 SER 分频器一个上界，不追求精确。 */
+static uint32_t
+k60_se_source(uint32_t cfg)
+{
+	switch ((cfg >> K60_RCG_SRC_SHIFT) & 7u) {
+	case 0:
+		return K60_XO_HZ;
+	case 1:
+		return K60_GPLL0_MAIN_HZ;
+	case 6:
+		return K60_GPLL0_EVEN_HZ;
+	default:
+		/* 未知父源：按 600 MHz 估，最多把 SPI 跑快，不会把分频器算小。 */
+		return K60_GPLL0_MAIN_HZ;
+	}
+}
+
+int
+k60_touch_clocks_on(void)
+{
+	uint32_t before, after, cmd, cfg, halt_m, halt_s, halt_se, halt_c, halt_c2;
+	unsigned i, missed = 0;
+
+	printf("K60 TOUCH: stage 3: gcc %#lx window %#lx, no SE access yet\n",
+	    (unsigned long)K60_TOUCH_GCC_BASE,
+	    (unsigned long)K60_TOUCH_GCC_WINDOW);
+	k60_touch_flush();
+	if (k60_gcc == 0) {
+		k60_gcc = ml_io_map(K60_TOUCH_GCC_BASE, K60_TOUCH_GCC_WINDOW);
+		if (k60_gcc == 0) {
+			printf("K60 TOUCH: gcc map failed\n");
+			return -1;
+		}
+	}
+
+	before = K60_TOUCH_RD(k60_gcc + K60_GCC_VOTE);
+	K60_TOUCH_WR(k60_gcc + K60_GCC_VOTE, before | K60_GCC_VOTE_MASK);
+	after = K60_TOUCH_RD(k60_gcc + K60_GCC_VOTE);
+	printf("K60 TOUCH: gcc vote %#x -> %#x, bits %#x\n", before, after,
+	    after & K60_GCC_VOTE_MASK);
+	for (i = 0; i < 5; i++) {
+		static const uint32_t bit[5] = { 6, 7, 8, 9, 14 };
+		uint32_t on = (after >> bit[i]) & 1u;
+
+		printf("K60 TOUCH: gcc vote bit%u on=%u\n", bit[i], on);
+		if (!on) {
+			missed++;
+		}
+	}
+	k60_touch_flush();
+	if (missed != 0) {
+		printf("K60 TOUCH: gcc refused %u vote bit(s), stopping before SE\n",
+		    missed);
+		return -1;
+	}
+
+	/* 分支 CBCR/HALT：bit31 清掉才是真的开着。 */
+	for (i = 0; i < 1000; i++) {
+		halt_m = K60_TOUCH_RD(k60_gcc + K60_GCC_M_AHB_HALT);
+		halt_s = K60_TOUCH_RD(k60_gcc + K60_GCC_S_AHB_HALT);
+		halt_se = K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_HALT);
+		halt_c = K60_TOUCH_RD(k60_gcc + K60_GCC_CORE_HALT);
+		halt_c2 = K60_TOUCH_RD(k60_gcc + K60_GCC_CORE_2X_HALT);
+		if (!((halt_m | halt_s | halt_se | halt_c | halt_c2) &
+		    K60_CLOCK_OFF)) {
+			break;
+		}
+		delay(10);
+	}
+	halt_m = K60_TOUCH_RD(k60_gcc + K60_GCC_M_AHB_HALT);
+	halt_s = K60_TOUCH_RD(k60_gcc + K60_GCC_S_AHB_HALT);
+	halt_se = K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_HALT);
+	halt_c = K60_TOUCH_RD(k60_gcc + K60_GCC_CORE_HALT);
+	halt_c2 = K60_TOUCH_RD(k60_gcc + K60_GCC_CORE_2X_HALT);
+	printf("K60 TOUCH: gcc halt m/s/se/c/c2 %#x/%#x/%#x/%#x/%#x\n",
+	    halt_m, halt_s, halt_se, halt_c, halt_c2);
+	k60_touch_flush();
+
+	/*
+	 * SE4 的根时钟。已经开着就只解码父源（供 SER 分频用），不重配：
+	 * 引导装载程序可能给了 100 MHz，改错反而把 SE 的时钟弄没。
+	 */
+	cmd = K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CMD);
+	cfg = K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CFG);
+	printf("K60 TOUCH: gcc se4 root cmd %#x cfg %#x\n", cmd, cfg);
+	k60_touch_flush();
+	if (cmd & K60_RCG_ROOT_OFF) {
+		/* 选 XO、不分频（CFG 的 [10:8]=0、[4:0]=0），再 UPDATE、ROOT_EN。 */
+		K60_TOUCH_WR(k60_gcc + K60_GCC_SE4_CFG,
+		    cfg & ~(K60_RCG_SRC_MASK | K60_RCG_DIV_MASK |
+		    K60_RCG_MODE_MASK));
+		K60_TOUCH_WR(k60_gcc + K60_GCC_SE4_CMD, K60_RCG_UPDATE);
+		for (i = 0; i < 1000; i++) {
+			if (!(K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CMD) &
+			    K60_RCG_UPDATE)) {
+				break;
+			}
+			delay(10);
+		}
+		if (i == 1000) {
+			printf("K60 TOUCH: gcc se4 update timed out, cmd %#x\n",
+			    K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CMD));
+			k60_touch_flush();
+			return -1;
+		}
+		K60_TOUCH_WR(k60_gcc + K60_GCC_SE4_CMD, K60_RCG_ROOT_EN);
+		delay(1000);
+		printf("K60 TOUCH: gcc se4 root was off, now cmd %#x cfg %#x\n",
+		    K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CMD),
+		    K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CFG));
+		k60_touch_flush();
+		cfg = K60_TOUCH_RD(k60_gcc + K60_GCC_SE4_CFG);
+	}
+	k60_se_source_hz = k60_se_source(cfg);
+
+	/*
+	 * 判据：三条分支的 halt 位都清了才算时钟真的在跑。只要有一条还立着，
+	 * 就停在 GENI 之前 —— 带着没起来的时钟去读 SE 是这一步唯一会把整机
+	 * 挂住的操作。
+	 */
+	if ((halt_m | halt_s | halt_se) & K60_CLOCK_OFF) {
+		printf("K60 TOUCH: clocks not ready (m/s/se %#x/%#x/%#x), "
+		    "stopping before SE\n", halt_m, halt_s, halt_se);
+		k60_touch_flush();
+		return -1;
+	}
+	printf("K60 TOUCH: clocks ready: vote %#x halt %#x/%#x/%#x source %u Hz\n",
+	    K60_TOUCH_RD(k60_gcc + K60_GCC_VOTE) & K60_GCC_VOTE_MASK, halt_m,
+	    halt_s, halt_se, k60_se_source_hz);
+	k60_touch_flush();
+	return 0;
+}
+
+static void
+k60_se_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = K60_TOUCH_RD(k60_se + K60_SE_RX_FIFO_STATUS);
+	uint32_t words = status & 0x01ffffffu, bytes = words * 4u;
+	uint32_t i;
+
+	/* 状态坏了（比如时钟没了读成 0xffffffff）时不能去无界地读 FIFO。 */
+	if (words > k60_fifo_depth) {
+		return;
+	}
+	if (status & 0x80000000u) {
+		uint32_t valid = (status >> 28) & 7u;
+
+		if (valid != 0 && valid < 4) {
+			bytes -= 4u - valid;
+		}
+	}
+	for (i = 0; i < words; i++) {
+		uint32_t word = K60_TOUCH_RD(k60_se + K60_SE_RX_FIFO);
+		int j;
+
+		for (j = 0; j < 4 && bytes != 0; j++, bytes--) {
+			if (*received < length) {
+				if (rx != NULL) {
+					rx[*received] =
+					    (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+static void
+k60_se_recover(void)
+{
+	int i;
+
+	K60_TOUCH_WR(k60_se + K60_SE_M_CMD_CTRL, 1u << 2);
+	for (i = 0; i < 2000 &&
+	    !(K60_TOUCH_RD(k60_se + K60_SE_M_IRQ_STATUS) & K60_M_CANCEL_ACK);
+	    i++) {
+		delay(100);
+	}
+	if (!(K60_TOUCH_RD(k60_se + K60_SE_M_IRQ_STATUS) & K60_M_CANCEL_ACK)) {
+		K60_TOUCH_WR(k60_se + K60_SE_M_CMD_CTRL, 1u << 1);
+		for (i = 0; i < 2000 && !(K60_TOUCH_RD(
+		    k60_se + K60_SE_M_IRQ_STATUS) & K60_M_ABORT_ACK); i++) {
+			delay(100);
+		}
+	}
+	for (i = 0; i < 64 && (K60_TOUCH_RD(k60_se + K60_SE_RX_FIFO_STATUS) &
+	    0x01ffffffu); i++) {
+		(void)K60_TOUCH_RD(k60_se + K60_SE_RX_FIFO);
+	}
+	K60_TOUCH_WR(k60_se + K60_SE_M_IRQ_CLEAR, 0xffffffffu);
+}
+
+/*
+ * 一笔全双工传输：CS 拉低到结尾（一条命令完成整笔），`length` 字节出去、
+ * 同样多回来。tx 为 NULL 时发 0。返回 0 = 收到 length 个字节。
+ */
+int
+k60_touch_geni_xfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	uint32_t sent = 0, received = 0, status = 0;
+	uint32_t txlen;
+	uint64_t deadline;
+	int i;
+
+	if (k60_se == 0) {
+		return -1;
+	}
+	txlen = k60_len_words ? (length + 3u) / 4u : length;
+	for (i = 0; K60_TOUCH_RD(k60_se + K60_SE_STATUS) & 1u; i++) {
+		if (i > 2000) {
+			k60_se_recover();
+			break;
+		}
+		delay(100);
+	}
+	K60_TOUCH_WR(k60_se + K60_SE_M_IRQ_CLEAR, 0xffffffffu);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_TX_TRANS_LEN, txlen);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_RX_TRANS_LEN, txlen);
+	K60_TOUCH_WR(k60_se + K60_SE_M_CMD0, K60_SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length &&
+		    (K60_TOUCH_RD(k60_se + K60_SE_TX_FIFO_STATUS) & 0x0fffffffu)
+		    + 1u < k60_fifo_depth) {
+			uint32_t word = 0;
+			int j;
+
+			for (j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx != NULL ? tx[sent] : 0) <<
+				    (8 * j);
+			}
+			K60_TOUCH_WR(k60_se + K60_SE_TX_FIFO, word);
+		}
+		status = K60_TOUCH_RD(k60_se + K60_SE_M_IRQ_STATUS);
+		k60_se_drain(rx, length, &received);
+		if (status & K60_M_ERRORS) {
+			break;
+		}
+		if (status & K60_M_DONE) {
+			k60_se_drain(rx, length, &received);
+			K60_TOUCH_WR(k60_se + K60_SE_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return 0;
+			}
+			break;
+		}
+	}
+	if (k60_xfer_complaints++ < 8) {
+		printf("K60 TOUCH: spi xfer %u bytes failed: status %#x sent %u "
+		    "received %u len_reg %u\n", length, status, sent, received,
+		    txlen);
+		k60_touch_flush();
+	}
+	k60_se_recover();
+	return -1;
+}
+
+/*
+ * 把 SE4 配成 SPI。只写 GENI 的配置寄存器，不碰固件（固件是引导装载程序
+ * 装进去的）。返回 0 或一个可以打进日志的原因字符串。
+ */
+int
+k60_touch_geni_bringup(uint32_t hz, const char **problem)
+{
+	static const uint32_t spi_pins[4] = {
+		K60_TOUCH_GPIO_CLK, K60_TOUCH_GPIO_MOSI,
+		K60_TOUCH_GPIO_MISO, K60_TOUCH_GPIO_CS,
+	};
+	uint32_t fw, depth, divider, mclk;
+	unsigned i;
+
+	*problem = "unknown";
+	printf("K60 TOUCH: stage 4: se4 %#lx, spi up to %u Hz\n",
+	    (unsigned long)K60_TOUCH_SE_BASE, hz);
+	k60_touch_flush();
+	if (k60_se == 0) {
+		k60_se = ml_io_map(K60_TOUCH_SE_BASE, K60_TOUCH_SE_WINDOW);
+		if (k60_se == 0) {
+			*problem = "cannot map se4";
+			return -1;
+		}
+	}
+	k60_len_words = 0;
+	(void)PE_parse_boot_argn("k60touchlenw", &k60_len_words,
+	    sizeof(k60_len_words));
+
+	fw = K60_TOUCH_RD(k60_se + K60_SE_FW_REVISION_RO);
+	printf("K60 TOUCH: se4 fw %#x version %u protocol %u (SPI=1)\n", fw,
+	    fw & 0xffu, (fw >> 8) & 0xffu);
+	k60_touch_flush();
+	if (((fw >> 8) & 0xffu) != 1u) {
+		*problem = "se4 has no SPI firmware";
+		return -1;
+	}
+	if (K60_TOUCH_RD(k60_se + K60_SE_IF_DISABLE_RO) & 1u) {
+		*problem = "se4 FIFO interface is disabled";
+		return -1;
+	}
+	depth = (K60_TOUCH_RD(k60_se + K60_SE_HW_PARAM_0) >> 16) & 0x3fu;
+	if (depth < 4) {
+		*problem = "se4 reports no FIFO";
+		return -1;
+	}
+	k60_fifo_depth = depth;
+
+	K60_TOUCH_WR(k60_se + K60_SE_GSI_EVENT_EN, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_M_IRQ_CLEAR, 0xffffffffu);
+	K60_TOUCH_WR(k60_se + K60_SE_S_IRQ_CLEAR, 0xffffffffu);
+	K60_TOUCH_WR(k60_se + K60_SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	K60_TOUCH_WR(k60_se + K60_SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	K60_TOUCH_WR(k60_se + K60_SE_CGC_CTRL,
+	    K60_TOUCH_RD(k60_se + K60_SE_CGC_CTRL) | 0x7fu);
+	K60_TOUCH_WR(k60_se + K60_SE_DMA_GENERAL_CFG,
+	    K60_TOUCH_RD(k60_se + K60_SE_DMA_GENERAL_CFG) | 0xfu);
+	K60_TOUCH_WR(k60_se + K60_SE_OUTPUT_CTRL, 0x7fu);
+	K60_TOUCH_WR(k60_se + K60_SE_FORCE_DEFAULT, 1);
+	K60_TOUCH_WR(k60_se + K60_SE_DMA_MODE_EN,
+	    K60_TOUCH_RD(k60_se + K60_SE_DMA_MODE_EN) & ~1u);
+	K60_TOUCH_WR(k60_se + K60_SE_RX_WATERMARK, depth - 3);
+	K60_TOUCH_WR(k60_se + K60_SE_RX_RFR_WATERMARK, depth - 2);
+	K60_TOUCH_WR(k60_se + K60_SE_TX_WATERMARK, 0);
+	/*
+	 * 中断全程屏蔽：这里只轮询，GIC SPI 605 没有人认领，使能了就是一条
+	 * 永远没人处理的中断。状态位不受它影响。
+	 */
+	K60_TOUCH_WR(k60_se + K60_SE_IRQ_EN, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_M_IRQ_EN, 0);
+
+	/* 模式 0、CS0、8 位、MSB 先、四个字节一个 FIFO 字。 */
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_LOOPBACK, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_DEMUX_SEL, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_CPHA, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_CPOL, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_DEMUX_OUTPUT_INV, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_TRANS_CFG,
+	    K60_TOUCH_RD(k60_se + K60_SE_SPI_TRANS_CFG) & ~2u);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_DELAY, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_TX_PACKING_0, K60_SPI_PACK_0);
+	K60_TOUCH_WR(k60_se + K60_SE_TX_PACKING_1, K60_SPI_PACK_1);
+	K60_TOUCH_WR(k60_se + K60_SE_RX_PACKING_0, K60_SPI_PACK_0);
+	K60_TOUCH_WR(k60_se + K60_SE_RX_PACKING_1, K60_SPI_PACK_1);
+	K60_TOUCH_WR(k60_se + K60_SE_BYTE_GRAN, 0);
+	K60_TOUCH_WR(k60_se + K60_SE_SPI_WORD_LEN, K60_SPI_WORD_LEN_VAL);
+
+	divider = (k60_se_source_hz + hz - 1) / hz;
+	if (divider == 0) {
+		divider = 1;
+	}
+	if (divider > 0xfffu) {
+		divider = 0xfffu;
+	}
+	K60_TOUCH_WR(k60_se + K60_SE_CLK_SEL, 0);
+	mclk = (divider << 4) | 1u;
+	K60_TOUCH_WR(k60_se + K60_SE_SER_M_CLK_CFG, mclk);
+
+	/* 四根线交给 QUP；CS 上拉，MISO/MOSI/CLK 不拉。 */
+	for (i = 0; i < 4; i++) {
+		if (k60_touch_pin_config(spi_pins[i], K60_TOUCH_PIN_FUNC_QUP,
+		    spi_pins[i] == K60_TOUCH_GPIO_CS ? K60_TOUCH_PIN_PULL_UP :
+		    K60_TOUCH_PIN_PULL_NONE, K60_TOUCH_PIN_DRIVE_8MA, 0) != 0) {
+			*problem = "spi pins do not take the QUP function";
+			return -1;
+		}
+	}
+	printf("K60 TOUCH: se4 pins gpio%u-%u -> qup\n", K60_TOUCH_GPIO_CLK,
+	    K60_TOUCH_GPIO_CS);
+	printf("K60 TOUCH: se4 spi cfg word %#x mclk %#x (source %u Hz / %u)\n",
+	    K60_TOUCH_RD(k60_se + K60_SE_SPI_WORD_LEN), mclk,
+	    k60_se_source_hz, divider);
+	printf("K60 TOUCH: se4 status %#x fifo %u words\n",
+	    K60_TOUCH_RD(k60_se + K60_SE_STATUS), k60_fifo_depth);
+	k60_touch_flush();
+	*problem = NULL;
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
