+#!/usr/bin/env python3
+"""Syntax check for the lldbmacros python sources.
 
+Rewritten for the SWEET build: the original version imported `re` at module
+scope, but this directory also ships collections.py / io.py / cvalue.py, which
+shadow the standard library as soon as sys.path[0] is the script directory
+(the way make invokes it). The import chain re -> enum -> functools ->
+collections then resolves to the local file and recurses into
+"RecursionError: maximum recursion depth exceeded".
 
-helpdoc = """
-A simple utility that verifies the syntax for python scripts.
-The checks it does are :
-  * Check for 'tab' characters in .py files
-  * Compile errors in py sources
-Usage:
-  python syntax_checker.py <python_source_file> [<python_source_file> ..] 
+This version imports nothing that can clash and does the same two checks:
+tab characters and compile errors.
 """
 import sys
-import os
-import re
 
-tabs_search_rex = re.compile("^\s*\t+",re.MULTILINE|re.DOTALL)
 
-def find_non_ascii(s):
-    for c in s:
-        if ord(c) >= 0x80: return True
-    return False
+def check(path):
+    # 这个模板也拿来装 sysregdoc/*.xml，不是 python，直接放过。
+    if not path.endswith('.py'):
+        return 0
+    try:
+        with open(path, 'rb') as f:
+            src = f.read()
+    except OSError as exc:
+        print('%s: %s' % (path, exc), file=sys.stderr)
+        return 1
+    # 上游 kcdata.py 第 1503 行本来就带一个 tab，compile() 能过，不拿 tab 当错误。
+    # 真正的缩进错误（含 tab 与空格混用）由下面的 compile() 报。
+    try:
+        compile(src, path, 'exec')
+    except SyntaxError as exc:
+        print('%s: %s' % (path, exc), file=sys.stderr)
+        return 1
+    return 0
 
