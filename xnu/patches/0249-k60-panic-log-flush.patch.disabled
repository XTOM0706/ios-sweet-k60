diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 3579a4e..a586446 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -55,6 +55,8 @@ extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
 extern void sweet_gpu_probe(void);
 extern void sweet_wlan_probe(void);
+/* osfmk/kern/debug.c: nonzero once a panic has started (the UFS command wait must not block then). */
+extern unsigned panic_active(void);
 
 #define REG_CAP         0x00
 #define REG_IS          0x20
@@ -210,7 +212,8 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	uint64_t deadline;
 	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
 	deadline += mach_absolute_time();
-	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	/* !panic_active(): the panic flush (sweet_log_panic_flush) must spin, never block the panicking thread. */
+	bool sleepable = su.wait && su.ready && !panic_active() && ml_get_interrupts_enabled() &&
 	    !ml_at_interrupt_context() && get_preemption_level() == 0;
 	uint64_t spin_until = 0, sleep_interval = 0;
 	if (sleepable) {
@@ -690,6 +693,15 @@ static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 static uint64_t _Atomic sweet_log_flushed_total;
 static int _Atomic sweet_log_running;
+/*
+ * Sequence of the last header written. Shared by the flush thread and the panic
+ * flush (sweet_log_panic_flush below), so the header's seq keeps counting up.
+ * NEXT AGENT: any new code that writes the header must go through
+ * sweet_log_write_header, or seq goes backwards.
+ */
+static uint64_t sweet_log_seq;
+/* 1 once the panic flush has started; a nested panic must not write again. */
+static int _Atomic sweet_log_panicking;
 
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
@@ -742,12 +754,50 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
+/*
+ * Writes ring bytes [pos, total) to the partition, in bounce-buffer-sized pieces.
+ * Caller holds sweet_ufs_lock, except the panic path (sweet_log_panic_flush),
+ * which must not take it: the holder may be stopped on another CPU.
+ */
+static int
+sweet_log_write_range(uint64_t base, uint64_t pos, uint64_t total)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	return error;
+}
+
+/* Writes the header block that says how many console bytes are on the device. Same caller rules as above. */
+static int
+sweet_log_write_header(uint64_t base, uint64_t total)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct sweet_log_header h = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+		.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++sweet_log_seq,
+	};
+
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &h, sizeof(h));
+	return ufs_write_blocks(base, 1);
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
-	uint64_t flushed = 0, seq = 0;
-	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t flushed = 0;
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
@@ -762,24 +812,9 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 		int error = 0;
 
 		lck_mtx_lock(&sweet_ufs_lock);
-		while (pos < total && !error) {
-			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
-			uint32_t blk = off / UFS_BLOCK;
-			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
-			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-			error = ufs_write_blocks(base + 1 + blk, n);
-			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-		}
+		error = sweet_log_write_range(base, pos, total);
 		if (!error) {
-			struct sweet_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			bzero(bounce, UFS_BLOCK);
-			memcpy(bounce, &h, sizeof(h));
-			error = ufs_write_blocks(base, 1);
+			error = sweet_log_write_header(base, total);
 		}
 		if (!error) {
 			error = ufs_sync_cache();
@@ -826,6 +861,44 @@ sweet_log_sync(void)
 	}
 }
 
+/*
+ * Panic flush, called from panic_trap_to_debugger (osfmk/kern/debug.c) before the
+ * debugger runs. The flush thread writes only every sweet_log_secs (default 10 s),
+ * so up to that much console is missing from the log when the machine panics.
+ * This writes the missing bytes and the header with polled UFS commands: no
+ * thread, no sleep, no sweet_ufs_lock. Other CPUs are stopped by the panic; a
+ * flush or sync that was mid-write on one may garble a few blocks of this log,
+ * which is accepted. Bounded: each command has CMD_TIMEOUT_NS, and the first
+ * failure stops the flush. A nested panic returns at once.
+ *
+ * NEXT AGENT: sweet_log_flushed_total is what the partition holds; update it
+ * only after a complete write, as the flush thread does.
+ */
+void sweet_log_panic_flush(void);
+
+void
+sweet_log_panic_flush(void)
+{
+	if (!sweet_log_ready() || os_atomic_xchg(&sweet_log_panicking, 1, relaxed)) {
+		return;
+	}
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t flushed = os_atomic_load(&sweet_log_flushed_total, relaxed);
+	uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+	int error = sweet_log_write_range(base, pos, total);
+
+	if (!error) {
+		error = sweet_log_write_header(base, total);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	if (!error) {
+		os_atomic_store(&sweet_log_flushed_total, total, relaxed);
+	}
+}
+
 static void
 sweet_log_start(void)
 {
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..fc91421 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -109,19 +109,41 @@ sweet_early_mark(unsigned int stage, const char *label)
 	sweet_early_putc('\n');
 }
 
+/*
+ * NEXT AGENT: the panic text goes to the framebuffer (when it is still on) and
+ * to the persistent log: sweet_log_append (bsd/dev/sweet_ufs.c) here, then
+ * sweet_log_panic_flush (called from panic_trap_to_debugger, osfmk/kern/debug.c)
+ * writes it to the partition. The log copy must not depend on early_disabled.
+ */
+extern void sweet_log_append(const char *c, int size);
+
+static void
+sweet_early_log_putc(char c)
+{
+	sweet_log_append(&c, 1);
+}
+
 void
 sweet_early_panic(const char *fmt, va_list *args)
 {
-	if (early_disabled || early_panicking) {
+	if (early_panicking) {
 		return;
 	}
 	early_panicking = 1;
-	sweet_early_string("\nSWEET EARLY PANIC: ");
-	va_list copy;
-	va_copy(copy, *args);
-	_doprnt(fmt, &copy, sweet_early_putc, 16);
-	va_end(copy);
-	sweet_early_putc('\n');
+	if (!early_disabled) {
+		sweet_early_string("\nSWEET EARLY PANIC: ");
+		va_list copy;
+		va_copy(copy, *args);
+		_doprnt(fmt, &copy, sweet_early_putc, 16);
+		va_end(copy);
+		sweet_early_putc('\n');
+	}
+	sweet_log_append("\nSWEET PANIC: ", 14);
+	va_list log;
+	va_copy(log, *args);
+	_doprnt(fmt, &log, sweet_early_log_putc, 16);
+	va_end(log);
+	sweet_log_append("\n", 1);
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 437adb1..26a14b7 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1075,6 +1075,10 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 #if defined(SWEET)
 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	sweet_early_panic(panic_format_str, panic_args);
+	/* sweet: the console bytes the persistent log has not written yet (up to sweet_log_secs of them), with polled UFS writes.
+	 * Implemented in bsd/dev/sweet_ufs.c; NEXT AGENT: keep it before the debugger, which may never return. */
+	extern void sweet_log_panic_flush(void);
+	sweet_log_panic_flush();
 #endif
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
