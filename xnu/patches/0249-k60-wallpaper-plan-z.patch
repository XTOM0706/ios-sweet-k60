+/* 刷一块面板矩形：有壁纸就用壁纸填，没有就刷黑。 */
+static void
+sweet_fb_fill_rect(uint8_t *pixels, uint32_t rowBytes, uint32_t x0, uint32_t y0,
+    uint32_t x1, uint32_t y1, const struct sweet_fb_wall *wall)
+{
+	if (x1 <= x0 || y1 <= y0) {
+		return;
+	}
+	if (wall != NULL) {
+		sweet_fb_wall_fill(wall, pixels, rowBytes, x0, y0, x1, y1);
+		return;
+	}
+	for (uint32_t y = y0; y < y1; y++) {
+		bzero(pixels + (uint64_t)y * rowBytes + (uint64_t)x0 * 4, (size_t)(x1 - x0) * 4);
+	}
+}
