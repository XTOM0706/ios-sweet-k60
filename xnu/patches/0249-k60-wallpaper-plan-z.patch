+/*
+ * ===== 壁纸（Plan Z） =====
+ *
+ * 锁屏黑不是因为合成器没工作：壁纸由 PaperBoard 自己的 FBScene 画，是另一个
+ * IOSurface。CPU 合成器只把 SpringBoard 主窗口那块 surface 拷进面板，壁纸层
+ * 从来没到过屏幕上，所以到底是黑的。
+ *
+ * Plan Z：内核自己先铺一张壁纸，再把 SpringBoard 的 surface 用 src-over 叠
+ * 上去（锁屏 UI 是透明的，透出来就是壁纸）。壁纸数据不进 patch：几 MB 的 C
+ * 数组会把 xnu/patches/** 的 CI 缓存键天天打穿，改一张图还要重编内核；改成
+ * 内核从根卷读一个已知路径的裸 BGRA 文件，读不到就维持今天的行为（黑底），
+ * 绝不阻塞启动。
+ */
+#define SWEET_WP_PATH_MAX       192
+#define SWEET_WP_MAX_BYTES      (24u * 1024 * 1024)
+#define SWEET_WP_DEFAULT_PATH   "/private/var/SweetWallpaper.bgra"
+#define SWEET_WP_DEFAULT_W      720
+#define SWEET_WP_DEFAULT_H      1600
+#define SWEET_WP_ALPHA_STEP     32      /* 判断"这层全不透明吗"的采样步长，像素 */
+
+/* 壁纸 -> 面板 的映射。32.32 定点，整数乘加，不查表不分配。 */
+struct sweet_fb_wall {
+	const uint8_t *pixels;          /* BGRA，行优先 */
+	uint32_t width, height, rowBytes;
+	uint64_t stepX, stepY;          /* 面板 1 像素 = 壁纸的多少像素（32.32） */
+};
+
+static void
+sweet_fb_wall_init(struct sweet_fb_wall *w, const uint8_t *pixels, uint32_t width,
+    uint32_t height, uint32_t panelW, uint32_t panelH)
+{
+	bzero(w, sizeof(*w));
+	w->pixels = pixels;
+	w->width = width;
+	w->height = height;
+	w->rowBytes = width * 4;
+	if (pixels == NULL || width == 0 || height == 0 || panelW == 0 || panelH == 0) {
+		return;
+	}
+	w->stepX = ((uint64_t)width << 32) / panelW;
+	w->stepY = ((uint64_t)height << 32) / panelH;
+}
+
+/* 面板 (x,y) 对应的壁纸像素。越界一律夹到最后一列/行，不读出去。 */
+static inline const uint8_t *
+sweet_fb_wall_at(const struct sweet_fb_wall *w, uint32_t x, uint32_t y)
+{
+	uint32_t wx = (uint32_t)(((uint64_t)x * w->stepX) >> 32);
+	uint32_t wy = (uint32_t)(((uint64_t)y * w->stepY) >> 32);
+
+	if (wx >= w->width) {
+		wx = w->width - 1;
+	}
+	if (wy >= w->height) {
+		wy = w->height - 1;
+	}
+	return w->pixels + (uint64_t)wy * w->rowBytes + (uint64_t)wx * 4;
+}
+
+/*
+ * CoreAnimation 交给我们的 surface 是**预乘 alpha** 的（CG 的默认约定），
+ * 所以默认按预乘算：out = src + dst * (1 - a)。boot-arg sweetwp_premul=0 切到
+ * 直乘（out = src * a + dst * (1 - a)），只是留个对照，锁屏上两者只差半透明
+ * 边缘那一圈。
+ *
+ * 像素是 BGRA（小端读成 0xAARRGGBB）。面板本身不透明，输出 alpha 一律 0xff。
+ * a=0/255 两档在锁屏上占绝大多数（大片空白 + 文字），先走捷径；中间档用
+ * /256 的定点近似，误差不超过 1，省掉除法。
+ */
+static inline uint32_t
+sweet_fb_over(uint32_t src, uint32_t dst, bool premul)
+{
+	uint32_t a = src >> 24;
+	uint32_t ia, b, g, r;
+
+	if (a == 0) {
+		return dst | 0xff000000;
+	}
+	if (a == 255) {
+		return src | 0xff000000;
+	}
+	ia = 255 - a;
+	if (premul) {
+		b = ((src & 0xff) * 256 + (dst & 0xff) * ia + 128) >> 8;
+		g = (((src >> 8) & 0xff) * 256 + ((dst >> 8) & 0xff) * ia + 128) >> 8;
+		r = (((src >> 16) & 0xff) * 256 + ((dst >> 16) & 0xff) * ia + 128) >> 8;
+	} else {
+		uint32_t sa = a + 1;
+
+		b = ((src & 0xff) * sa + (dst & 0xff) * ia + 128) >> 8;
+		g = (((src >> 8) & 0xff) * sa + ((dst >> 8) & 0xff) * ia + 128) >> 8;
+		r = (((src >> 16) & 0xff) * sa + ((dst >> 16) & 0xff) * ia + 128) >> 8;
+	}
+	return 0xff000000 | (r << 16) | (g << 8) | b;
+}
+
+/* 预乘还是直乘，start() 里按 boot-arg 定一次；默认预乘（CG/IOSurface 的约定）。 */
+static bool sweet_fb_premul = true;
+
+/*
+ * 这一层是不是全不透明？按 SWEET_WP_ALPHA_STEP 像素一行扫过去，碰到任何一个
+ * a != 255 就认定半透明——宁可多走一遍混合，也不要把壁纸盖死。460 万像素按
+ * 步长 32 只剩 14 万次读，几百微秒。
+ */
+static bool
+sweet_fb_layer_opaque(const uint8_t *pixels, uint32_t rowBytes, int32_t x, int32_t y,
+    int32_t w, int32_t h)
+{
+	if (pixels == NULL || w <= 0 || h <= 0) {
+		return true;
+	}
+	for (int32_t ry = 0; ry < h; ry++) {
+		const uint8_t *row = pixels + (uint64_t)(y + ry) * rowBytes + (uint64_t)x * 4;
+		/*
+		 * 每行的起点按行号错开：步长固定 32 又总是从 0 开始的话，碰上"每 4
+		 * 个像素一个不透明像素"这种规整图案，采到的全是同一档次，会把半透明
+		 * 层误判成不透明，壁纸就被盖死了。
+		 */
+		int32_t start = ry & (SWEET_WP_ALPHA_STEP - 1);
+
+		for (int32_t rx = start; rx < w; rx += SWEET_WP_ALPHA_STEP) {
+			if (row[(uint64_t)rx * 4 + 3] != 0xff) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+/* 用壁纸填一块面板矩形（最近邻放大）。dst 是面板，坐标是面板坐标。 */
+static void
+sweet_fb_wall_fill(const struct sweet_fb_wall *w, uint8_t *dst, uint32_t dstRowBytes,
+    uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+{
+	if (w == NULL || w->pixels == NULL || x1 <= x0 || y1 <= y0) {
+		return;
+	}
+	for (uint32_t y = y0; y < y1; y++) {
+		uint32_t wy = (uint32_t)(((uint64_t)y * w->stepY) >> 32);
+		const uint8_t *wrow;
+		uint8_t *drow = dst + (uint64_t)y * dstRowBytes + (uint64_t)x0 * 4;
+
+		if (wy >= w->height) {
+			wy = w->height - 1;
+		}
+		wrow = w->pixels + (uint64_t)wy * w->rowBytes;
+		for (uint32_t x = x0; x < x1; x++) {
+			uint32_t wx = (uint32_t)(((uint64_t)x * w->stepX) >> 32);
+
+			if (wx >= w->width) {
+				wx = w->width - 1;
+			}
+			memcpy(drow, wrow + (uint64_t)wx * 4, 4);
+			drow[3] = 0xff;
+			drow += 4;
+		}
+	}
+}
+
+/* 拷一个以 0 结尾的路径。kernel 里没有 snprintf，这点事自己干，省个头文件。 */
+static void
+sweet_fb_copy_path(char *dst, const char *src, uint32_t max)
+{
+	uint32_t i = 0;
+
+	if (max == 0) {
+		return;
+	}
+	while (src[i] != '\0' && i + 1 < max) {
+		dst[i] = src[i];
+		i++;
+	}
+	dst[i] = '\0';
+}
