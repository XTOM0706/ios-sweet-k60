+
+/*
+ * 从根卷读整个文件到新分配的 kernel 缓冲。必须在进程上下文里调用（拿得到
+ * 凭据和 vfs 上下文）：SwapEnd 是 backboardd 的 IOConnectCallStructMethod，
+ * 正好满足，也正好是根卷挂好之后。任何一步失败都返回 NULL，调用方就当没有
+ * 壁纸，照旧跑。
+ */
+static void *
+sweet_fb_read_file(const char *path, uint32_t maxSize, uint32_t *outSize)
+{
+	vfs_context_t ctx;
+	struct vnode_attr va;
+	vnode_t vp = NULL;
+	uint8_t *buf;
+	uint32_t size, done = 0;
+	int resid;
+
+	ctx = vfs_context_current();
+	if (ctx == NULL) {
+		ctx = vfs_context_kernel();
+	}
+	if (ctx == NULL || vnode_lookup(path, 0, &vp, ctx) != 0 || vp == NULL) {
+		/*
+		 * 进程的根目录或凭据不对时（daemon 在 jail 里跑的场合）用内核上下文
+		 * 再试一次：这是一次性读取，读不到就当没有壁纸。
+		 */
+		vp = NULL;
+		ctx = vfs_context_kernel();
+		if (ctx == NULL || vnode_lookup(path, 0, &vp, ctx) != 0 || vp == NULL) {
+			return NULL;
+		}
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) != 0 || !VATTR_IS_ACTIVE(&va, va_data_size)) {
+		vnode_put(vp);
+		return NULL;
+	}
+	size = (uint32_t)va.va_data_size;
+	if (size == 0 || size > maxSize || (size & 3) != 0) {
+		vnode_put(vp);
+		return NULL;
+	}
+	buf = (uint8_t *)IOMallocData(size);
+	if (buf == NULL) {
+		vnode_put(vp);
+		return NULL;
+	}
+	/* 分块读：一次 4 MB 的 uio 没必要，HFS 的簇读也更好受。 */
+	while (done < size) {
+		uint32_t chunk = size - done;
+
+		if (chunk > 1024 * 1024) {
+			chunk = 1024 * 1024;
+		}
+		resid = 0;
+		/* 不传 IO_NODELOCKED：vnode_lookup 返回的 vnode 没有锁在手上。 */
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)(buf + done), (int)chunk, (off_t)done,
+		    UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, NULL) != 0 ||
+		    resid != 0) {
+			IOFreeData(buf, size);
+			buf = NULL;
+			break;
+		}
+		done += chunk;
+	}
+	vnode_put(vp);
+	if (buf != NULL) {
+		*outSize = size;
+	}
+	return buf;
+}
+
+/*
+ * 混合时可选的一层"底"。传 NULL 就是原来的整块拷贝（全不透明的层走这条快路）；
+ * 非 NULL 就是逐像素 dst = over(源, 底)，底由 wall 决定：
+ *   wall != NULL  底是壁纸——源就是面板自己的时候用（读一行、混一行、写一行）；
+ *   wall == NULL  底是面板当前内容——面板里已经铺过壁纸。
+ */
+struct sweet_fb_base {
+	const struct sweet_fb_wall *wall;
+	bool premul;                    /* 源像素是不是预乘 alpha */
+};
+
+/*
+ * 混合模式下写一个目的像素：底 = 壁纸（wall 非 0）或面板当前内容。
+ *   rowx  这一行里目的像素的下标（drow 已经指向行首）
+ *   px,py 目的像素的面板绝对坐标（查壁纸用）
+ */
+static inline void
+sweet_fb_store(uint32_t *drow, uint32_t rowx, uint32_t px, uint32_t py,
+    uint32_t src, const struct sweet_fb_base *over)
+{
+	uint32_t base, out;
+
+	if (over->wall != NULL) {
+		memcpy(&base, sweet_fb_wall_at(over->wall, px, py), 4);
+	} else {
+		base = drow[rowx];
+	}
+	out = sweet_fb_over(src, base, over->premul);
+	memcpy(&drow[rowx], &out, 4);
+}
